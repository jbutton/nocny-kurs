{
  "name": "nocny-kurs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "SIM=1 vitest run --silent=false",
    "api:dev": "cd worker && wrangler d1 migrations apply nocny-kurs --local && wrangler dev --port 8787",
    "api:deploy": "cd worker && wrangler d1 migrations apply nocny-kurs --remote && wrangler deploy",
    "test:e2e": "astro build && playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@fontsource/bungee": "^5.3.0",
    "@lucide/svelte": "^1.68.0",
    "@tanstack/store": "^0.11.2",
    "@tanstack/svelte-query": "^6.3.10",
    "@tanstack/svelte-store": "^0.12.3",
    "astro": "^7.4.5",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
